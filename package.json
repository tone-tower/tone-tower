{
  "name": "tone-tower",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "audio:review": "node --import tsx tools/content/listening-cli.mjs review",
    "audio:import-review": "node --import tsx tools/content/listening-cli.mjs import-review",
    "audio:coverage": "node --import tsx tools/content/listening-cli.mjs coverage",
    "audio:analyze": "node --import tsx tools/content/listening-cli.mjs analyze",
    "mandarin:tones": "node --import tsx tools/content/tone-examples.mjs",
    "catalog": "node --import tsx tools/catalog/build.mjs",
    "prestart": "npm run catalog",
    "start": "node --import tsx tools/server/serve.mjs",
    "build": "node --import tsx tools/publishing/build.mjs",
    "preview": "node --import tsx tools/server/serve.mjs --dist",
    "check:dist": "node --import tsx tools/publishing/check.mjs",
    "test": "vitest run --project=node",
    "test:tooling": "node tools/testing/tooling.mjs",
    "test:all": "vitest run && npm run test:tooling",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:download": "node --import tsx tools/audio/download.mjs",
    "audio:download:mandarin": "node --import tsx tools/audio/collection-cli.mjs download --collection cmn",
    "audio:status:mandarin": "node --import tsx tools/audio/collection-cli.mjs status --collection cmn",
    "audio:discover": "node --import tsx tools/audio/discover.mjs",
    "audio:select": "node --import tsx tools/audio/select.mjs",
    "audio:import": "node --import tsx tools/audio/import-curated.mjs",
    "audio:verify": "node --import tsx tools/audio/verify.mjs",
    "audio:sync": "node --import tsx tools/catalog/sync.mjs",
    "audio:metadata": "node --import tsx tools/catalog/metadata.mjs",
    "audio:status": "node --import tsx tools/audio/status.mjs",
    "audio:export": "node --import tsx tools/audio/import-curated.mjs --export-only",
    "test:browser": "npm run build && playwright test",
    "mandarin:dictionary": "node --import tsx tools/content/mandarin-cli.mjs dictionary",
    "mandarin:review": "node --import tsx tools/content/listening-cli.mjs review --language cmn",
    "mandarin:import-review": "node --import tsx tools/content/listening-cli.mjs import-review --language cmn",
    "mandarin:status": "node --import tsx tools/content/mandarin-cli.mjs status",
    "mandarin:correct": "node --import tsx tools/content/mandarin-cli.mjs correct",
    "typecheck": "tsc --noEmit",
    "test:controllers": "vitest run --project=browser",
    "vietnamese:import": "node --import tsx tools/content/vietnamese-cli.mjs import",
    "vietnamese:status": "node --import tsx tools/content/vietnamese-cli.mjs status"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "opencc-js": "1.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
